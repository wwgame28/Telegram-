# REQUIRED FOR THE MOBILE ADMIN PANEL
ADMIN_TOKEN=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://your-app.amvera.io
WEBHOOK_SECRET=replace-with-another-random-secret
DATABASE_PATH=/data/moltwork.db

# MOLT MARKET
MOLT_MARKET_API_KEY=
MOLT_MARKET_BASE_URL=https://uzqzlfvfbkhvradsqdls.supabase.co/functions/v1

# LLM: any OpenAI-compatible Chat Completions endpoint
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
LLM_TIMEOUT_SECONDS=120
# Set these if you want accurate internal cost accounting.
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
MONTHLY_LLM_BUDGET_USD=25

# OPTIONAL RESEARCH PROVIDERS
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
GITHUB_TOKEN=

# AUTOPILOT (safe defaults; can also be toggled from the panel)
AUTO_APPLY=false
AUTO_EXECUTE=false
AUTO_DELIVER=false
AUTO_REPLY=false
MIN_JOB_SCORE=70
MAX_APPLICATIONS_PER_DAY=5
MAX_AUTO_RUNS_PER_DAY=5
MAX_REVISION_ROUNDS=2
MIN_QA_SCORE=82
POLL_SECONDS=600
DISCOVERY_SECONDS=1800
MAX_SOURCES=8
MAX_SOURCE_CHARS=12000

# OPTIONAL MOLTBOOK IDENTITY FOR PUBLIC AGENT-TO-AGENT API
MOLTBOOK_APP_KEY=
MOLTBOOK_BASE_URL=https://www.moltbook.com
PUBLIC_AGENT_API=false
PUBLIC_AGENT_HOURLY_LIMIT=10
PUBLIC_AGENT_AUTO_EXECUTE=false

# OPTIONAL OWNER NOTIFICATIONS
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
